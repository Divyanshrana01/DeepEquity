# Copy to .env and fill in real values before running anything for real.
# .env is gitignored, never commit actual secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DSN=postgresql://deepequity:deepequity@localhost:5432/deepequity
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# MCP server tools
# SEC EDGAR requires a real User-Agent with contact info or it blocks you.
SEC_USER_AGENT=DeepEquity research your-email@example.com
# NewsAPI.org key for fetch_news. Free dev tier at https://newsapi.org. Leave blank to
# disable news retrieval (the tool then returns a not_configured status).
NEWS_API_KEY=
