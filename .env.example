# Copy to .env and fill in real values before running anything for real.
# .env is gitignored, never commit actual secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DSN=postgresql://deepequity:deepequity@localhost:5432/deepequity
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
