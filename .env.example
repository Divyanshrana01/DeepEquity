# Copy to .env and fill in real values before running anything for real.
# .env is gitignored, never commit actual secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DSN=postgresql://deepequity:deepequity@localhost:5432/deepequity
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Where the api and worker reach the MCP server. Inside docker compose this is
# http://mcp-server:8000/mcp, the compose file sets that automatically.
MCP_SERVER_URL=http://localhost:8001/mcp

# Hosts the MCP server will answer to. This is DNS rebinding protection, keep it tight,
# only add hosts you actually serve on.
MCP_ALLOWED_HOSTS=mcp-server:8000,localhost:8001,127.0.0.1:8001

# Ingestion retry policy: how many attempts before a document goes to the dead letter
# queue, and the base for the exponential backoff between attempts (1s, 4s, 16s).
INGESTION_MAX_ATTEMPTS=3
INGESTION_BACKOFF_BASE_SECONDS=4.0

# LLM (Groq free tier). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Two tiers, this is the model routing: small one for scoping and extraction, big one
# for synthesis where the reasoning matters. Both support strict JSON schema output.
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_STRONG_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3

# Limits that stop a debate running away, in time and in money
MAX_DEBATE_ROUNDS=2
MAX_TOKENS_PER_RUN=120000

# MCP server tools
# SEC EDGAR requires a real User-Agent with contact info or it blocks you.
SEC_USER_AGENT=DeepEquity research your-email@example.com
# NewsAPI.org key for fetch_news. Free dev tier at https://newsapi.org. Leave blank to
# disable news retrieval (the tool then returns a not_configured status).
NEWS_API_KEY=
